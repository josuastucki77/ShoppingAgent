# Lokaler Ollama-Server; kein kostenpflichtiger API-Zugang erforderlich.
OLLAMA_BASE_URL=http://192.168.1.111:11434/v1
OLLAMA_MODEL=shopping-qwen3.5-9b:latest
OLLAMA_BASE_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_CONTEXT_LENGTH=65536
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_EMBEDDING_DIMENSIONS=768
# SDK-Platzhalter, bei einem ungeschuetzten lokalen Ollama kein echter API-Key.
OLLAMA_API_KEY=ollama

SHOPPING_USER=josua
SHOPPING_CRON="0 9 * * *"
TZ=Europe/Zurich
GALAXUS_MCP_URL=https://mcp.galaxus.ch

# Festgelegte Versionen; Updates bewusst vornehmen und erneut testen.
HERMES_IMAGE=nousresearch/hermes-agent:v0.23.1
HONCHO_SOURCE=https://github.com/plastic-labs/honcho.git#ca81eed3ddca57d7407854c5f447195779dcabf2

# setup.sh / setup.ps1 erzeugen diesen Wert beim ersten Start automatisch.
# POSTGRES_PASSWORD=
